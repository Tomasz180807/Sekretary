# Vorlage – nach .env kopieren und ausfüllen. Die .env selbst ist über
# .gitignore ausgeschlossen und darf nie eingecheckt werden.

# Token von @BotFather (Telegram). Wer ihn hat, steuert den Bot vollständig.
TELEGRAM_BOT_TOKEN=123456789:AAAbbbCCCdddEEEfffGGGhhhIIIjjjKKKlll

# Chat-IDs, die Antworten bekommen dürfen. Komma- oder leerzeichengetrennt.
# LEER LASSEN heißt Einrichtungsmodus: Der Bot verrät dann nur die Chat-ID
# und gibt keine Plandaten heraus. Erst eintragen, dann neu starten.
TELEGRAM_ALLOWED_CHAT_IDS=

# Optional: anderer Pfad zum Wochenplan.
# SEKRETARY_PLAN=/pfad/zu/wochenplan.json
